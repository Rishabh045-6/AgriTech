########################################
# APPLICATION ENVIRONMENT
########################################
NODE_ENV=development
PORT=3001

########################################
# DATABASE CONFIGURATION
########################################
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agritech_dev
DB_USER=agritech_user
DB_PASSWORD=your_secure_password_here

# Enable SSL only in production
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

########################################
# SENTINEL HUB CONFIGURATION
########################################
# Use ONE active client at a time
# Rotation should be handled in code, not env duplication
SENTINEL_CLIENT_ID=your_sentinel_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret
# Optional multi-client rotation (backend tries _1 ... _6 in order):
# SENTINEL_CLIENT_1_ID=your_sentinel_client_1_id
# SENTINEL_CLIENT_1_SECRET=your_sentinel_client_1_secret
# SENTINEL_CLIENT_2_ID=your_sentinel_client_2_id
# SENTINEL_CLIENT_2_SECRET=your_sentinel_client_2_secret

# Synthetic fallback behavior when Sentinel fetch fails:
# If unset, fallback is ON for non-production and OFF for production.
# Set explicitly to true/false to override.
ALLOW_SYNTHETIC_FALLBACK=true

########################################
# SECURITY
########################################
# Required for auth, tokens, signing, etc.
JWT_SECRET=your_very_long_and_secure_random_string_min_32_chars

########################################
# PATH CONFIGURATION
########################################
MODELS_PATH=./models
SCALERS_PATH=./scalers
DATA_PATH=./data
LOGS_PATH=./logs

########################################
# API & RUNTIME LIMITS
########################################
API_TIMEOUT=30000
MAX_REQUEST_SIZE=10mb
MAX_COORDINATES=50
MAX_INFERENCE_TIME_SECONDS=30

########################################
# ML / INFERENCE SETTINGS
########################################
TORCH_DEVICE=cpu
TORCH_NUM_THREADS=4
MODEL_LOAD_STRICT=false

########################################
# LOGGING
########################################
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false

########################################
# FEATURE FLAGS (OPTIONAL)
#######################
