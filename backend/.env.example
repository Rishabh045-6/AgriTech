# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agritech
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Sentinel Hub Configuration (Add your actual credentials)
SENTINEL_CLIENT_1_ID=your_first_client_id
SENTINEL_CLIENT_1_SECRET=your_first_client_secret
SENTINEL_CLIENT_2_ID=your_second_client_id
SENTINEL_CLIENT_2_SECRET=your_second_client_secret
SENTINEL_CLIENT_3_ID=your_third_client_id
SENTINEL_CLIENT_3_SECRET=your_third_client_secret
SENTINEL_CLIENT_4_ID=your_fourth_client_id
SENTINEL_CLIENT_4_SECRET=your_fourth_client_secret
SENTINEL_CLIENT_5_ID=your_fifth_client_id
SENTINEL_CLIENT_5_SECRET=your_fifth_client_secret
SENTINEL_CLIENT_6_ID=your_sixth_client_id
SENTINEL_CLIENT_6_SECRET=your_sixth_client_secret

# Server Configuration
PORT=3001
NODE_ENV=development

# File Paths
MODELS_PATH=./models
SCALERS_PATH=./scalers
DATA_PATH=./data