{
  "name": "agritech-backend",
  "version": "1.0.0",
  "description": "Agritech backend with security enhancements",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "security-check": "npm audit",
    "test": "jest",
    "lint": "eslint .",
    "build": "npm run build:server",
    "clean": "rm -rf dist/ && rm -rf node_modules/"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^6.11.0",
    "helmet": "^7.1.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "body-parser": "^1.20.2",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "multer": "^1.4.5-lts.1",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "@jest/globals": "^29.7.0",
    "jest-fetch-mock": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "agritech",
    "crop-analysis",
    "machine-learning",
    "satellite-data",
    "react-native",
    "agriculture"
  ],
  "author": "Rishabh045-6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rishabh045-6/AgriTech.git"
  },
  "bugs": {
    "url": "https://github.com/Rishabh045-6/AgriTech/issues"
  },
  "homepage": "https://github.com/Rishabh045-6/AgriTech#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/coverage/**"
    ]
  }
}